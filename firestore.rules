rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownerUid() { return get(/databases/$(database)/documents/meta/config).data.ownerUid; }
    function isOwner() { return signedIn() && exists(/databases/$(database)/documents/meta/config) && ownerUid() == request.auth.uid; }

    // 주인 정보: 리리 비번 계정(이메일/비밀번호 로그인)만 한 번 만들 수 있고, 이후엔 못 바꿈
    match /meta/config {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email == 'riri@riri-playground.app'
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if false;
    }

    // 캐릭터
    match /chars/{id} {
      allow read: if signedIn();
      // 주인은 다 되고, 다른 사람은 내 uid 이름으로 내 캐릭터 하나만 만들고 지울 수 있음
      allow create: if isOwner() || (
        signedIn() && id == request.auth.uid
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'nt', 'look', 'status', 'st', 'owner', 'order', 'desk'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 12
      );
      allow delete: if isOwner() || (signedIn() && id != 'riri' && resource.data.owner == request.auth.uid)
        // 4시간 넘게 접속 안 한 사람 캐릭터는 누구나 정리 가능
        || (signedIn() && id != 'riri' && exists(/databases/$(database)/documents/presence/$(id))
            && get(/databases/$(database)/documents/presence/$(id)).data.seen < request.time.toMillis() - 14400000);
      allow update: if isOwner() || (
        signedIn() && id != 'riri'
        // 주인 없는 캐릭터거나 내 캐릭터일 때만
        && (resource.data.owner == '' || resource.data.owner == request.auth.uid)
        // 소유자는 비우거나 나로만
        && (request.resource.data.owner == '' || request.resource.data.owner == request.auth.uid)
        // 순서는 못 바꿈 (외형은 내 캐릭터만 바꿀 수 있음)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'nt', 'status', 'st', 'owner', 'look', 'desk'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['look']) || resource.data.owner == request.auth.uid)
        && request.resource.data.name is string && request.resource.data.name.size() <= 12
      );
    }

    // 담타/소리지르기 같은 순간 이벤트 (30초 뒤 지움)
    match /events/{eid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.t is number;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // 옥상 전광판: 한 사람당 글 하나, 10분에 한 번만 다시 쓸 수 있어요
    match /board/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['text', 'name', 't'])
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 30
        && request.resource.data.name is string && request.resource.data.name.size() <= 12
        && request.resource.data.t is number
        && request.resource.data.t > request.time.toMillis() - 120000 && request.resource.data.t < request.time.toMillis() + 120000
        && (resource == null || request.time.toMillis() > resource.data.t + 540000);
      allow delete: if isOwner() || (signedIn() && uid == request.auth.uid);
    }

    // 접속자 수
    match /presence/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && uid == request.auth.uid
        && (request.resource == null || request.resource.data.keys().hasOnly(['seen', 'name']));
    }
  }
}
